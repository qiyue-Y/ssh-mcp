{
  "defaults": {
    "idle_timeout_s": 30,
    "max_duration_s": 300,
    "max_output_bytes": 8388608
  },

  "killlist": [
    "mkfs*",
    "wipefs",
    "dd of=/dev/",
    "fdisk /dev/",
    "parted",
    "shutdown",
    "reboot",
    "halt",
    "poweroff",
    "init 0",
    "init 6",
    "iptables -F",
    "iptables -X",
    "nft flush",
    "ufw disable",
    "systemctl stop sshd",
    "systemctl stop ssh",
    "systemctl stop firewalld",
    "systemctl disable sshd",
    "systemctl disable ssh",
    "userdel",
    "groupdel",
    "passwd",
    "chown -R /",
    "chmod 777 /"
  ]
}
