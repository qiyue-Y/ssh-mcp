{
  "defaults": {
    "idle_timeout_s": 30,
    "max_duration_s": 300,
    "max_output_bytes": 8388608,
    "grant_ttl_default": "30m"
  },

  "hosts": {
    "66": { "purpose": "agt-ai 服务器（ClickHouse + VLLM + Celery）" },
    "new8": { "purpose": "new8卡 Ubuntu 机器" },
    "100": { "purpose": "Rocky Linux 10.2 机器" },
    "admin": { "purpose": "pve2 Proxmox 宿主机（root 账号）" }
  },

  "ro_allowlist": [
    "hostname",
    "uname",
    "uptime",
    "date",
    "w",
    "who",
    "id",
    "groups",
    "env",
    "printenv",
    "locale",
    "which",
    "whereis",
    "type",
    "df",
    "du",
    "free",
    "ls",
    "stat",
    "file",
    "readlink",
    "realpath",
    "basename",
    "dirname",
    "cat",
    "head",
    "tail",
    "wc",
    "sort",
    "uniq",
    "cut",
    "tr",
    "grep",
    "egrep",
    "fgrep",
    "zcat",
    "zgrep",
    "md5sum",
    "sha256sum",
    "find",
    "cd",
    "pwd",
    "ip",
    "ss",
    "netstat",
    "ps",
    "top -bn1",
    "lscpu",
    "lsblk",
    "fdisk -l",
    "lsmod",
    "dmesg",
    "hostnamectl",
    "lsb_release",
    "systemctl status",
    "systemctl is-active",
    "systemctl is-enabled",
    "systemctl show",
    "systemctl list-units",
    "systemctl list-timers",
    "journalctl",
    "crontab -l",
    "rpm -q",
    "rpm -qa",
    "dpkg -l",
    "pip list",
    "pip show",
    "pip3 list",
    "python --version",
    "python3 --version",
    "node -v",
    "nvidia-smi",
    "docker ps",
    "docker images",
    "docker inspect",
    "docker logs",
    "docker version",
    "docker info",
    "docker system df",
    "kubectl get",
    "kubectl describe",
    "kubectl logs",
    "kubectl top",
    "kubectl version",
    "curl",
    "wget"
  ],

  "ro_deny_flags": {
    "find": ["-exec", "-execdir", "-ok", "-okdir", "-delete", "-fprint", "-fprint0", "-fprintf", "-fls"],
    "dmesg": ["-C", "--clear", "-r", "--read-clear"],
    "journalctl": ["--rotate", "--flush", "--sync"],
    "docker": ["--config"],
    "tail": ["-f", "--follow"],
    "wget": ["-i", "--input-file", "--post-file", "--post-data"]
  },

  "ro_deny_paths": [
    "/etc/shadow",
    "/etc/gshadow",
    "/etc/sudoers",
    "/etc/ssh/sshd_config",
    "/proc/1/environ",
    ".ssh/",
    "id_rsa",
    "id_ed25519",
    "id_ecdsa",
    "id_dsa",
    "authorized_keys",
    ".bash_history",
    "/root/",
    "kube/config",
    ".git-credentials",
    ".netrc",
    "shadow"
  ],

  "interpreters": [
    "sh",
    "bash",
    "zsh",
    "dash",
    "ksh",
    "csh",
    "fish",
    "python",
    "python2",
    "python3",
    "perl",
    "ruby",
    "node",
    "php",
    "lua",
    "tclsh",
    "expect",
    "awk",
    "gawk",
    "mawk",
    "sed",
    "xargs"
  ],

  "rw_denylist": [
    "sudo",
    "su",
    "rm -rf /",
    "rm -rf /etc",
    "rm -rf /usr",
    "rm -rf /var",
    "rm -rf /var/lib",
    "rm -rf /boot",
    "rm -rf /bin",
    "rm -rf /sbin",
    "rm -rf /lib",
    "rm -rf /lib64",
    "rm -rf /root",
    "rm -rf /home",
    "rm -rf /dev",
    "rm -rf /proc",
    "rm -rf /sys",
    "mkfs*",
    "mkswap",
    "dd of=/dev/",
    "fdisk /dev/",
    "parted",
    "wipefs",
    "lsattr -R /",
    "chattr -R",
    "shutdown",
    "reboot",
    "halt",
    "poweroff",
    "init",
    "telinit",
    "systemctl stop sshd",
    "systemctl stop ssh",
    "systemctl stop firewalld",
    "systemctl disable sshd",
    "systemctl disable ssh",
    "iptables -F",
    "iptables -X",
    "nft flush",
    "ufw disable",
    "userdel",
    "groupdel",
    "useradd",
    "adduser",
    "groupadd",
    "passwd",
    "chpasswd",
    "usermod",
    "chmod 777 /",
    "chmod -R 777 /",
    "chown -R /",
    "mount",
    "umount",
    "crontab -r",
    "tee /etc/*",
    "tee /boot/*",
    "tee /root/*",
    "tee /usr/*",
    "tee /var/*",
    "history -c",
    "docker rm -f",
    "docker system prune -af",
    "kubectl delete"
  ],

  "broad_grant_markers": [
    "apt",
    "apt-get",
    "dnf",
    "yum",
    "zypper",
    "snap",
    "pip",
    "pip3",
    "npm",
    "npx",
    "yarn",
    "cargo",
    "gem",
    "composer",
    "docker",
    "podman",
    "systemctl",
    "make"
  ]
}
