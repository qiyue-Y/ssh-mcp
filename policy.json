{
  "defaults": {
    "idle_timeout_s": 30,
    "max_duration_s": 300,
    "max_output_bytes": 8388608,
    "xfer_dir": "D:\\temporaryfile\\download",
    "xfer_timeout_s": 1800,
    "xfer_chunk_bytes": 1048576,
    "max_transfer_bytes": 4294967296,
    "job_retention_days": 7,
    "job_max_concurrent": 8
  },
  "guarded_hosts": [
    "66"
  ],
  "killlist": [
    "mkfs*",
    "wipefs",
    "dd of=/dev/",
    "fdisk /dev/",
    "parted",
    "sgdisk --zap-all",
    "sgdisk -Z",
    "sgdisk --clear",
    "sgdisk -o",
    "blkdiscard",
    "lvremove",
    "vgremove",
    "pvremove",
    "mdadm --zero-superblock",
    "mdadm --create",
    "cryptsetup luksFormat",
    "cryptsetup luksErase",
    "cryptsetup erase",
    "zpool destroy",
    "zfs destroy",
    "btrfs subvolume delete",
    "shutdown",
    "reboot",
    "halt",
    "poweroff",
    "systemctl reboot",
    "systemctl poweroff",
    "systemctl halt",
    "systemctl kexec",
    "systemctl soft-reboot",
    "init 0",
    "init 6",
    "telinit 0",
    "telinit 6",
    "systemctl stop sshd",
    "systemctl stop ssh",
    "systemctl stop firewalld",
    "systemctl disable sshd",
    "systemctl disable ssh",
    "systemctl mask sshd",
    "systemctl mask ssh",
    "systemctl stop networking",
    "systemctl disable networking",
    "iptables -F",
    "iptables -X",
    "iptables -P INPUT DROP",
    "iptables -P OUTPUT DROP",
    "iptables -P FORWARD DROP",
    "nft flush",
    "ufw disable",
    "userdel",
    "groupdel",
    "passwd",
    "chpasswd",
    "usermod -L",
    "chown -R /",
    "chmod 777 /",
    "find -delete",
    "shred",
    "truncate /dev/",
    "dropdb",
    "mysqladmin drop",
    "redis-cli flushall",
    "redis-cli flushdb",
    "docker system prune",
    "docker volume prune",
    "docker volume rm",
    "kubectl delete pvc",
    "kubectl delete namespace",
    "kubectl delete ns",
    "virsh undefine --remove-all-storage",
    "virsh vol-delete"
  ]
}
